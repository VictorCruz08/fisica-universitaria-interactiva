---
import { tex } from '../../lib/katex';

interface Props {
  tarjetas: { titulo: string; texto: string; formula?: string; n?: string }[];
}
const { tarjetas } = Astro.props;
---

<section class="resumen">
  <div class="rejilla">
    {
      tarjetas.map((t) => (
        <article class="tarjeta aparece">
          <h4 class="ui">{t.titulo}</h4>
          {t.formula && <div class="formula" set:html={tex(t.formula, true)} />}
          <p>{t.texto}</p>
          {t.n && <span class="n ui">Ec. ({t.n})</span>}
        </article>
      ))
    }
  </div>
</section>

<style>
  .resumen {
    margin: 2rem calc(50% - min(50vw - 16px, var(--ancho-figura) / 2));
  }
  .rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: 1rem;
  }
  .tarjeta {
    position: relative;
    padding: 1.1rem 1.2rem 1.3rem;
    border-radius: var(--radio-l);
    background: var(--fondo-elevado);
    border: 1px solid var(--linea);
    box-shadow: var(--sombra);
  }
  h4 {
    margin: 0;
    padding-right: 4.5rem;
    font-size: var(--t-sm);
    color: var(--azul);
  }
  .formula :global(.katex-display) {
    margin: 0.7rem 0;
  }
  p {
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.55;
    color: var(--tinta-2);
  }
  .n {
    position: absolute;
    top: 1.1rem;
    right: 1.2rem;
    font-size: var(--t-xs);
    color: var(--ocre);
    font-weight: 600;
  }
</style>
