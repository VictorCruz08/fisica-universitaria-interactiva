---
import { tex } from '../../lib/katex';

interface Props {
  /** Fuente TeX de la ecuación (modo display). */
  tex: string;
  /** Número de la ecuación en el libro, p. ej. "1.6". */
  n?: string;
  /** Nota corta a la derecha, p. ej. "θ medido desde +x". */
  nota?: string;
  destacada?: boolean;
}

const { tex: fuente, n, nota, destacada = false } = Astro.props;
const html = tex(fuente, true);
---

<div class:list={['ecuacion', { destacada }]} id={n ? `ec-${n}` : undefined}>
  <div class="cuerpo" set:html={html} />
  {
    (n || nota) && (
      <div class="lado ui">
        {nota && <span class="nota">{nota}</span>}
        {n && <span class="num">({n})</span>}
      </div>
    )
  }
</div>

<style>
  .ecuacion {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 1.6rem 0;
    padding: 0.2rem 0;
  }
  .ecuacion.destacada {
    padding: 0.4rem 1.2rem;
    border-radius: var(--radio);
    background: var(--fondo-elevado);
    box-shadow: var(--sombra);
    border: 1px solid var(--linea);
  }
  .cuerpo {
    flex: 1;
    min-width: 0;
  }
  .cuerpo :global(.katex-display) {
    margin: 0.6rem 0;
  }
  .lado {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.15rem;
    flex-shrink: 0;
    text-align: right;
  }
  .num {
    font-size: var(--t-sm);
    color: var(--ocre);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .nota {
    font-size: var(--t-xs);
    color: var(--tinta-3);
    max-width: 11rem;
    line-height: 1.35;
  }
  @media (max-width: 560px) {
    .ecuacion {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }
    .lado {
      flex-direction: row-reverse;
      justify-content: space-between;
      align-items: baseline;
    }
  }
</style>
