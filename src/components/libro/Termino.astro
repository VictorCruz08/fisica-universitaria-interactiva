---
import { glosario } from '../../data/glosario';

interface Props {
  /** Clave en src/data/glosario.ts */
  id: string;
}

const { id } = Astro.props;
const entrada = glosario[id];
if (!entrada) throw new Error(`Término de glosario desconocido: "${id}"`);
const idTip = `tip-${id}-${Math.random().toString(36).slice(2, 7)}`;
---

<style>
  .termino {
    position: relative;
    display: inline;
  }
  .palabra {
    display: inline;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: inherit;
    cursor: help;
    text-decoration: underline dotted;
    text-decoration-color: var(--ocre);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.22em;
  }
  .tip {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 10px);
    z-index: 40;
    width: min(18rem, 80vw);
    padding: 0.75rem 0.9rem;
    border-radius: var(--radio);
    background: var(--fondo-elevado);
    border: 1px solid var(--linea);
    box-shadow: var(--sombra-l);
    font-size: var(--t-sm);
    font-weight: 400;
    line-height: 1.5;
    color: var(--tinta-2);
    text-align: left;
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, 6px) scale(0.98);
    transform-origin: bottom center;
    transition:
      opacity var(--dur-1) var(--ease),
      transform var(--dur-2) var(--ease-out),
      visibility var(--dur-1);
    pointer-events: none;
  }
  .tip strong {
    display: block;
    color: var(--tinta);
    font-weight: 620;
    margin-bottom: 0.15rem;
  }
  .termino:hover .tip,
  .palabra:focus-visible + .tip,
  .palabra:focus + .tip {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0) scale(1);
  }
  @media (max-width: 560px) {
    .tip {
      position: fixed;
      left: 16px;
      right: 16px;
      bottom: 16px;
      width: auto;
      transform: translateY(8px);
    }
    .termino:hover .tip,
    .palabra:focus-visible + .tip,
    .palabra:focus + .tip {
      transform: none;
    }
  }
</style>

<span class="termino"><button type="button" class="palabra" aria-describedby={idTip}><slot /></button><span class="tip ui" role="tooltip" id={idTip}><strong>{entrada.termino}</strong>{entrada.definicion}</span></span>