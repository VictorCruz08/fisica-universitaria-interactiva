---
interface Props {
  seccion: string;
}
const { seccion } = Astro.props;
---

<section class="evalua aparece">
  <header class="ui">
    <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
      <circle cx="10" cy="10" r="8" fill="none" stroke="currentColor" stroke-width="1.7"></circle>
      <path d="M6.5 10.2 L9 12.6 L13.8 7.6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
    <span>Evalúe su comprensión de la sección {seccion}</span>
  </header>
  <slot />
</section>

<style>
  .evalua {
    margin: 3rem 0;
    padding: 1.3rem 1.5rem 1.2rem;
    border-radius: var(--radio-l);
    background: var(--caja-evalua);
    border: 1px solid var(--caja-evalua-borde);
  }
  header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--azul);
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 0.6rem;
  }
</style>
