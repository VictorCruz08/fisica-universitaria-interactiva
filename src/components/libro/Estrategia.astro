---
interface Props {
  numero: string;
  titulo: string;
}
const { numero, titulo } = Astro.props;
---

<section class="estrategia aparece">
  <header class="ui">
    <span class="sup">Estrategia para resolver problemas {numero}</span>
    <h4>{titulo}</h4>
  </header>
  <div class="cuerpo"><slot /></div>
</section>

<style>
  .estrategia {
    margin: 2.5rem 0;
    padding: 1.4rem 1.5rem 0.6rem;
    border-radius: var(--radio-l);
    background: var(--caja-estrategia);
    border: 1px solid var(--caja-ejemplo-borde);
  }
  .sup {
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ocre);
  }
  h4 {
    margin: 0.2rem 0 0.6rem;
    font-size: var(--t-lg);
  }
  .cuerpo :global(ol) {
    padding-left: 1.2rem;
  }
  .cuerpo :global(.ipee) {
    font-family: var(--fuente-ui);
    font-size: 0.8em;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ocre);
  }
</style>
