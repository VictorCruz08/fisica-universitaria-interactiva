---
interface Props {
  titulo: string;
}
const { titulo } = Astro.props;
---

<aside class="cuidado aparece">
  <div class="cabeza ui">
    <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
      <path d="M10 2.5 L18 16.5 H2 Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path>
      <path d="M10 8 V11.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
      <circle cx="10" cy="14" r="1" fill="currentColor"></circle>
    </svg>
    <span class="etiqueta">Cuidado</span>
    <span class="titulo">{titulo}</span>
  </div>
  <div class="cuerpo"><slot /></div>
</aside>

<style>
  .cuidado {
    margin: 2rem 0;
    padding: 1.1rem 1.3rem 0.4rem;
    border-radius: var(--radio);
    background: var(--caja-cuidado);
    border: 1px solid var(--caja-cuidado-borde);
  }
  .cabeza {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    color: var(--rojo);
    font-size: var(--t-sm);
  }
  .etiqueta {
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: var(--t-xs);
  }
  .titulo {
    color: var(--tinta);
    font-weight: 600;
  }
  .cuerpo {
    font-size: 1.04rem;
  }
</style>
