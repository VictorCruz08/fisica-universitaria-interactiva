---
import { getCollection, render } from 'astro:content';
import SeccionLayout from '../../layouts/SeccionLayout.astro';
import { seccionesPublicadas } from '../../data/indice';

export async function getStaticPaths() {
  const entradas = await getCollection('secciones');
  const orden = seccionesPublicadas();
  return entradas.map((entrada) => {
    const { capitulo, seccion } = entrada.data;
    const i = orden.findIndex((s) => s.slug === `${capitulo}/${seccion}`);
    if (i < 0) throw new Error(`La sección ${capitulo}.${seccion} no tiene slug en src/data/indice.ts`);
    return {
      params: { cap: String(capitulo), seccion: String(seccion) },
      props: { entrada, actual: orden[i], anterior: orden[i - 1], siguiente: orden[i + 1] },
    };
  });
}

const { entrada, actual, anterior, siguiente } = Astro.props;
const { Content, headings } = await render(entrada);
---

<SeccionLayout
  capitulo={actual.capitulo}
  tituloCapitulo={actual.tituloCapitulo}
  numero={actual.numero}
  titulo={entrada.data.titulo}
  resumen={entrada.data.resumen}
  paginaLibro={entrada.data.paginaLibro}
  minutos={entrada.data.minutos}
  encabezados={headings}
  anterior={anterior}
  siguiente={siguiente}
>
  <Content />
</SeccionLayout>
