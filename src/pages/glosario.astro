---
import BaseLayout from '../layouts/BaseLayout.astro';
import { glosario } from '../data/glosario';

const entradas = Object.entries(glosario).sort((a, b) => a[1].termino.localeCompare(b[1].termino, 'es'));
const letras = [...new Set(entradas.map(([, e]) => e.termino[0].toUpperCase()))];
---

<BaseLayout titulo="Glosario" descripcion="Términos clave con definiciones breves, en orden alfabético.">
  <main class="glosario">
    <p class="sobre ui">Referencia</p>
    <h1>Glosario</h1>
    <p class="lead">
      Las palabras subrayadas con puntos en el texto aparecen aquí. Cada definición indica la sección donde se presenta.
    </p>
    <nav class="letras ui" aria-label="Letras">
      {letras.map((l) => <a href={`#letra-${l}`}>{l}</a>)}
    </nav>
    {
      letras.map((l) => (
        <section id={`letra-${l}`}>
          <h2 class="ui">{l}</h2>
          <dl>
            {entradas
              .filter(([, e]) => e.termino[0].toUpperCase() === l)
              .map(([id, e]) => (
                <div class="entrada aparece" id={id}>
                  <dt>{e.termino}</dt>
                  <dd>
                    {e.definicion} <span class="sec ui">§ {e.seccion}</span>
                  </dd>
                </div>
              ))}
          </dl>
        </section>
      ))
    }
  </main>
</BaseLayout>

<style>
  .glosario {
    max-width: var(--ancho-texto);
    margin: 0 auto;
    padding: clamp(3rem, 8vw, 5rem) 16px 0;
  }
  .sobre {
    margin: 0;
    font-size: var(--t-sm);
    color: var(--tinta-3);
  }
  h1 {
    margin: 0.4rem 0 0;
    font-size: var(--t-3xl);
    letter-spacing: -0.04em;
  }
  .lead {
    color: var(--tinta-2);
    font-size: 1.15rem;
  }
  .letras {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 2rem 0;
  }
  .letras a {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    border: 1px solid var(--linea);
    text-decoration: none;
    font-size: var(--t-sm);
    font-weight: 600;
  }
  h2 {
    margin: 2.5rem 0 0.5rem;
    font-size: var(--t-xl);
    color: var(--ocre);
  }
  dl {
    margin: 0;
  }
  .entrada {
    padding: 0.9rem 0;
    border-top: 1px solid var(--linea);
  }
  dt {
    font-family: var(--fuente-ui);
    font-weight: 650;
  }
  dd {
    margin: 0.2rem 0 0;
    color: var(--tinta-2);
  }
  .sec {
    font-size: var(--t-xs);
    color: var(--tinta-3);
    white-space: nowrap;
  }
</style>
