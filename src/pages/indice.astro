---
import BaseLayout from '../layouts/BaseLayout.astro';
import { indice } from '../data/indice';
import { url } from '../lib/url';

const total = indice.flatMap((p) => p.capitulos.flatMap((c) => c.secciones)).length;
const listas = indice.flatMap((p) => p.capitulos.flatMap((c) => c.secciones)).filter((s) => s.slug).length;
---

<BaseLayout titulo="Índice" descripcion="Contenido completo del Volumen 1: secciones disponibles y próximas.">
  <main class="indice">
    <header>
      <p class="sobre ui">Contenido · Volumen 1</p>
      <h1>Índice</h1>
      <p class="lead">
        Sigue el orden del libro de texto. Las secciones con enlace ya están disponibles; las demás irán apareciendo.
        El número de página corresponde a la 12.ª edición impresa, por si estudias con ella.
      </p>
      <div class="progreso ui" aria-label={`${listas} de ${total} secciones disponibles`}>
        <div class="barra"><span style={`width:${(100 * listas) / total}%`}></span></div>
        <span>{listas} de {total} secciones</span>
      </div>
    </header>

    {
      indice.map((parte) => (
        <section class="parte">
          <h2 class="ui">{parte.titulo}</h2>
          {parte.capitulos.map((cap) => {
            const disponibles = cap.secciones.filter((s) => s.slug).length;
            return (
              <details class="capitulo aparece" open={disponibles > 0}>
                <summary>
                  <span class="num ui">{cap.numero}</span>
                  <span class="tit">{cap.titulo}</span>
                  {disponibles > 0 && <span class="pastilla ui">{disponibles} disponibles</span>}
                  <span class="pag ui">{cap.pagina}</span>
                </summary>
                <ol>
                  {cap.secciones.map((s) => (
                    <li class:list={{ lista: Boolean(s.slug) }}>
                      {s.slug ? (
                        <a href={url(s.slug)}>
                          <span class="sn ui">{s.numero}</span>
                          <span>{s.titulo}</span>
                        </a>
                      ) : (
                        <span class="pendiente">
                          <span class="sn ui">{s.numero}</span>
                          <span>
                            {s.titulo}
                            {s.opcional && <span class="opc ui"> opcional</span>}
                          </span>
                        </span>
                      )}
                      <span class="pag ui">{s.pagina}</span>
                    </li>
                  ))}
                </ol>
              </details>
            );
          })}
        </section>
      ))
    }
  </main>
</BaseLayout>

<style>
  .indice {
    max-width: var(--ancho-texto);
    margin: 0 auto;
    padding: clamp(3rem, 8vw, 5rem) 16px 0;
  }
  .sobre {
    margin: 0;
    font-size: var(--t-sm);
    color: var(--tinta-3);
  }
  h1 {
    margin: 0.4rem 0 0;
    font-size: var(--t-3xl);
    letter-spacing: -0.04em;
  }
  .lead {
    color: var(--tinta-2);
    font-size: 1.15rem;
  }
  .progreso {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: var(--t-xs);
    color: var(--tinta-3);
  }
  .barra {
    flex: 1;
    height: 6px;
    border-radius: 3px;
    background: var(--fondo-hundido);
    overflow: hidden;
  }
  .barra span {
    display: block;
    height: 100%;
    min-width: 6px;
    border-radius: 3px;
    background: linear-gradient(90deg, var(--azul), var(--verde));
  }
  .parte h2 {
    margin: 4rem 0 1rem;
    font-size: var(--t-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ocre);
  }
  .capitulo {
    border-top: 1px solid var(--linea);
  }
  summary {
    display: grid;
    grid-template-columns: 2.6rem 1fr auto auto;
    align-items: baseline;
    gap: 0.8rem;
    padding: 1rem 0;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .num {
    font-weight: 700;
    font-size: 1.4rem;
    color: var(--tinta-3);
  }
  .capitulo[open] .num {
    color: var(--azul);
  }
  .tit {
    font-family: var(--fuente-ui);
    font-weight: 600;
    font-size: 1.12rem;
    letter-spacing: -0.01em;
  }
  .pastilla {
    font-size: var(--t-xs);
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--verde) 14%, transparent);
    color: var(--verde);
    font-weight: 600;
  }
  .pag {
    font-size: var(--t-xs);
    color: var(--tinta-3);
    font-variant-numeric: tabular-nums;
  }
  ol {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0 0 0 3.4rem;
  }
  li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: baseline;
    padding: 0.35rem 0;
  }
  li a,
  .pendiente {
    display: flex;
    gap: 0.8rem;
    align-items: baseline;
  }
  li a {
    color: var(--tinta);
    text-decoration: none;
    font-weight: 500;
  }
  li a:hover span:last-child {
    color: var(--azul);
  }
  .pendiente {
    color: var(--tinta-3);
  }
  .sn {
    min-width: 2.4rem;
    font-size: var(--t-sm);
    font-variant-numeric: tabular-nums;
  }
  .lista .sn {
    color: var(--ocre);
    font-weight: 700;
  }
  .opc {
    font-size: var(--t-xs);
    color: var(--tinta-3);
    font-style: italic;
  }
  @media (max-width: 560px) {
    summary {
      grid-template-columns: 2.2rem 1fr auto;
    }
    summary .pastilla {
      display: none;
    }
    ol {
      padding-left: 0.4rem;
    }
  }
</style>
